# Copier en .env (ignoré par Git) et compléter. Utilisé par les outils Python sur le PC.

# Chaîne de connexion Supabase : bouton « Connect » du projet > Session pooler > URI
# (remplacer [YOUR-PASSWORD] par le mot de passe de la base)
DATABASE_URL=

# Identifiant « vendorid » du site measurements.mobile-alerts.eu (collecte manuelle uniquement ;
# en production, il est stocké dans les secrets de l'Edge Function)
MA_VENDOR_ID=

# Fuseau horaire des dates affichées par le site Mobile Alerts
MA_TIMEZONE=Europe/Paris

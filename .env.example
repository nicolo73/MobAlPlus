# Copier en .env (ignoré par Git) et compléter.

# Connexion PostgreSQL (docker compose : voir docker-compose.yml)
DATABASE_URL=postgresql://mobalplus:mobalplus@localhost:5432/mobalplus

# Identifiant « vendorid » utilisé par le site measurements.mobile-alerts.eu (secret)
MA_VENDOR_ID=

# Phone ID de l'application Mobile Alerts (secret, pour l'API REST ; pas encore utilisé)
MA_PHONE_ID=

# Fuseau horaire des dates affichées par le site Mobile Alerts
MA_TIMEZONE=Europe/Paris

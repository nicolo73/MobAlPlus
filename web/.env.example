# Copier en .env.local pour le développement ; en production, variables de Cloudflare Pages.
# Sans ces variables, l'application démarre en mode démo (données fictives).
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<clé publique anon / publishable>

# « true » une fois le fournisseur Google activé dans Supabase (Authentication > Sign In / Providers)
VITE_AUTH_GOOGLE=false
